{
  "name": "arena-auto-battler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "servidor:build": "vite build --config servidor/vite.config.ts",
    "servidor": "npm run servidor:build && node dist-servidor/index.js",
    "lote": "vitest run --config ferramentas/vitest.config.ts --silent=false 2>&1 | grep -v \"^ *$\"",
    "arte": "vite build --config ferramentas/arte/vite.config.ts --logLevel warn && node dist-ferramentas/montar_atlas.js",
    "arte:atlas": "vite build --config ferramentas/arte/vite.config.ts --logLevel warn && node dist-ferramentas/montar_atlas.js --so-atlas",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@colyseus/core": "0.18.28",
    "@colyseus/sdk": "0.18.10",
    "@colyseus/ws-transport": "0.18.5",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
